# SecureMailScope Backend — Environment Configuration
# Copy this to .env and adjust for your local setup.

# ─── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console       # Use "json" in production

# ─── Server ──────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
RELOAD=true

# ─── Database ────────────────────────────────────────────────────────────────
# Development: SQLite (zero setup)
DATABASE_URL=sqlite+aiosqlite:///./securemailscope.db
# Production: PostgreSQL
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/securemailscope

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:4173"]

# ─── File storage ────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=200

# ─── Analysis ────────────────────────────────────────────────────────────────
RULES_DIR=../rules
ANALYSIS_TIMEOUT_SECONDS=300
